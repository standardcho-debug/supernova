# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Local Claude config
.claude/settings.local.json
CLAUDE.local.md

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
.next/
.turbo/
dist/
build/
*.log

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl
crash.log
plan.out
# Lambda build artifacts (zips are derived from source .mjs, regenerated by archive_file)
infra/clients/*/lambda/*.zip

# Env
.env
.env.local
.env.*.local
*.local.env
# direnv / 운영자 환경변수 (PEXELS_API_KEY 등 외부 API 공유 키 보관)
.envrc

# Demo seed manifest — backend-django boilerplate 의 seed_demo / flush_demo 가 사용
.demo-seed-manifest.json

# Client projects (each managed separately)
# si root 는 운영 함대(.claude, docs) 만 추적.
# 특정 클라이언트를 추적 대상으로 끌어오려면 아래에 ! 로 예외 추가.
/clients/

# Claude Code local-only settings (PAT 등 머신·세션 종속 값)
.claude/settings.local.json

# Build/cache artifacts
*.tmp
*.bak
.cache/

# 계약서 PII (spec docs/decisions/2026-06-04-contract-command-design.md §6.1)
# 계좌·사업자번호·금액 포함 — git history 사후삭제 어려움. draft·실값 config 추적 제외.
docs/templates/contract-party.yaml
docs/contracts/**
!docs/contracts/README.md

# superpowers brainstorming mockups (local, ephemeral)
.superpowers/

# superpowers 산출물 (specs·plans·briefs·qa-reports 등) — 워킹 파일. born-local·die-local.
# 내구 기록은 platform change-log + (근원적 fleet 결정 한정) docs/decisions 승격.
# 근거: docs/decisions/2026-07-20-superpowers-lifecycle-git-hygiene.md
docs/superpowers/

# Playwright MCP browser artifacts (QA 스냅샷·콘솔로그 — ephemeral)
.playwright-mcp/

# bizmsg Phase 2 — 비즈톡 콘솔 세션 (자격·쿠키 — git 커밋 절대 금지)
scripts/bizmsg/.session/

# playwright-head 로그인 세션 (구글/스토어 콘솔 자격·쿠키 — git 커밋 절대 금지)
scripts/browser/.session/

# 통화녹음 intake (call-intake) — PII·무거운 venv, 절대 커밋 금지
ops/inbox/calls/
scripts/call/.venv/
scripts/call/__pycache__/

# 위생 — orphan/untracked 노이즈 방지 (docs/decisions/2026-06-20-platform-soT-write-guard.md)
# .artifacts/ : 함대(qa·guide·조사 스크립트)의 일회성 산출물. 어느 위치든 ephemeral.
.artifacts/
# 루트에 떨어지는 QA·시각검증 스크린샷 (정식 자산은 .artifacts/ 또는 client repo). 루트 png 만 차단.
/*.png
# 루트에 떨어지는 Playwright a11y 스냅샷 덤프 (browser_snapshot 을 파일로 저장한 것 — ephemeral)
/*.yml
# born-local working 중간산출물 (생성기가 매번 재생성 — 내구 SoT 는 platform DB / git 아님)
#   PRD: /spec 산출, platform DB 로 이관 (CLAUDE.md 참조). guide _src: guide 빌드 중간물(PDF 결과물만 유지).
#   bizmsg specs: /bizmsg draft TemplateSpec. 셋 다 삭제해도 재생성 가능.
docs/prd/
docs/guides/_src-*/
docs/guides/**/_src-*/
scripts/bizmsg/specs/
# OpenTofu outputs 핸드오프·타이밍 — `tofu output` 으로 재생성되는 머신-로컬 산출물 (커밋 X)
clients/*/infra/outputs.json
clients/*/infra/.timing
# git worktrees (SDD 격리 작업공간 — 커밋 X)
.claude/worktrees/

# raw-deploy 훅 세션-스코프 탈출구 마커 (절대 커밋 금지 — 커밋되면 가드 무력화)
.claude/.allow-raw-deploy

# git worktrees — 정본 위치(클라별): .worktrees/<client>/<name>
.worktrees/
